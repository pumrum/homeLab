{
  "permissions": {
    "deny": [
      "Read(//c/automation/**)",
      "Edit(//c/automation/**)",
      "Read(**/config.toml)",
      "Edit(**/config.toml)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.ppk)",
      "Edit(**/*.ppk)",
      "Read(**/token*.json)",
      "Edit(**/token*.json)",
      "Read(**/*secret*.json)",
      "Edit(**/*secret*.json)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/profiles/**)",
      "Edit(**/profiles/**)",
      "Read(**/runs/**)",
      "Edit(**/runs/**)",
      "Read(**/trace.zip)",
      "Edit(**/trace.zip)",
      "Read(**/*.dpapi)",
      "Edit(**/*.dpapi)",
      "Read(~/.automation/**)",
      "Edit(~/.automation/**)",
      "Bash(cmdkey *)",
      "Bash(keyring *)",
      "Bash(uv run python tools/import_secret_file.py *)",
      "Bash(uv run python tools\\import_secret_file.py *)",
      "PowerShell(uv run python tools/import_secret_file.py *)",
      "PowerShell(uv run python tools\\import_secret_file.py *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "PowerShell(cmdkey *)",
      "PowerShell(keyring *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git commit --no-verify *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(gh pr merge *)",
      "PowerShell(git tag *)",
      "PowerShell(gh pr merge *)"
    ],
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(pre-commit run *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "PowerShell(git push origin feature/*)",
      "PowerShell(git push -u origin feature/*)"
    ]
  }
}
